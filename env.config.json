{
  "$schema": "./public/layer-catalog.schema.json",
  "version": 1,
  "defaultBaseLayerId": "google-satellite",
  "defaults": {
    "levelOffset": -1.7
  },
  "sources": [
    {
      "id": "google-satellite",
      "name": "Google 卫星影像",
      "kind": "xyz-raster",
      "urlTemplate": "https://mt{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
      "subdomains": ["0", "1", "2", "3"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "Google Maps",
      "termsUrl": "https://developers.google.com/maps/documentation/tile/policies",
      "status": "experimental",
      "note": "兼容旧版 XYZ 端点；生产环境应迁移到需要 API Key 与会话令牌的 Google Map Tiles API。"
    },
    {
      "id": "google-roadmap",
      "name": "Google 道路地图",
      "kind": "xyz-raster",
      "urlTemplate": "https://mt{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}",
      "subdomains": ["0", "1", "2", "3"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "Google Maps",
      "termsUrl": "https://developers.google.com/maps/documentation/tile/policies",
      "status": "experimental",
      "note": "兼容旧版 XYZ 端点。"
    },
    {
      "id": "google-hybrid",
      "name": "Google 卫星混合图",
      "kind": "xyz-raster",
      "urlTemplate": "https://mt{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}",
      "subdomains": ["0", "1", "2", "3"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "Google Maps",
      "termsUrl": "https://developers.google.com/maps/documentation/tile/policies",
      "status": "experimental",
      "note": "兼容旧版 XYZ 端点。"
    },
    {
      "id": "google-terrain-map",
      "name": "Google 地形地图",
      "kind": "xyz-raster",
      "urlTemplate": "https://mt{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}",
      "subdomains": ["0", "1", "2", "3"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "Google Maps",
      "termsUrl": "https://developers.google.com/maps/documentation/tile/policies",
      "status": "experimental",
      "note": "这是地形制图底图，不是 Terrain-RGB 高程。"
    },
    {
      "id": "osm-standard",
      "name": "OpenStreetMap 标准地图",
      "kind": "xyz-raster",
      "urlTemplate": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "minLevel": 0,
      "maxLevel": 19,
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors",
      "termsUrl": "https://operations.osmfoundation.org/policies/tiles/",
      "status": "stable",
      "note": "只用于正常交互浏览；必须显示署名并遵守缓存、Referer 与禁止批量下载要求。"
    },
    {
      "id": "osm-humanitarian",
      "name": "HOT 人道主义地图（OSM 数据）",
      "kind": "xyz-raster",
      "urlTemplate": "https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png",
      "subdomains": ["a", "b", "c"],
      "minLevel": 0,
      "maxLevel": 19,
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors · Tiles style by HOT",
      "termsUrl": "https://www.hotosm.org/",
      "status": "experimental",
      "note": "第三方 OSM 栅格样式，不属于 OSMF 标准瓦片服务。"
    },
    {
      "id": "osm-vector",
      "name": "OpenStreetMap 官方矢量瓦片",
      "kind": "mvt",
      "urlTemplate": "https://vector.openstreetmap.org/${OSM_VECTOR_VERSION}/{z}/{x}/{y}.mvt",
      "requires": ["OSM_VECTOR_VERSION"],
      "minLevel": 0,
      "maxLevel": 14,
      "attribution": "© OpenStreetMap contributors",
      "termsUrl": "https://operations.osmfoundation.org/policies/vector/",
      "status": "planned",
      "note": "已进入图层目录，但要等原生 GPU MVT 样式渲染器接入后启用。"
    },
    {
      "id": "tianditu-imagery",
      "name": "天地图影像底图",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/img_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=img&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable"
    },
    {
      "id": "tianditu-imagery-labels",
      "name": "天地图影像中文注记",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/cia_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=cia&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable"
    },
    {
      "id": "tianditu-vector",
      "name": "天地图矢量底图（栅格服务）",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/vec_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=vec&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable",
      "note": "名称中的“矢量”是天地图产品类型，当前接口返回已绘制栅格瓦片；不是客户端 MVT。"
    },
    {
      "id": "tianditu-vector-labels",
      "name": "天地图矢量中文注记",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/cva_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=cva&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable"
    },
    {
      "id": "tianditu-terrain",
      "name": "天地图地形晕渲",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/ter_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=ter&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 14,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable",
      "note": "这是地形晕渲底图，不是 Terrain-RGB 高程。"
    },
    {
      "id": "tianditu-terrain-labels",
      "name": "天地图地形中文注记",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/cta_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=cta&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 14,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable"
    },
    {
      "id": "esri-vector-basemap",
      "name": "Esri 矢量底图（兼容栅格化）",
      "kind": "rasterized-vector-style",
      "styleUrl": "https://www.arcgis.com/sharing/rest/content/items/e6621c30972e4eb7967ad862a4da977d/resources/styles/root.json",
      "sourceId": "esri",
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 512,
      "minimumLodLevelOffset": -1,
      "showCountryLabels": true,
      "attribution": "Esri",
      "status": "stable",
      "note": "MVT 在 CPU/Canvas 按样式绘制为纹理；保留为 ArcGIS Style 兼容渲染路径。"
    },
    {
      "id": "maptiler-streets",
      "name": "MapTiler Streets（兼容栅格化）",
      "kind": "rasterized-vector-style",
      "styleUrl": "https://api.maptiler.com/maps/streets-v4/style.json?key=${MAPTILER_KEY}",
      "requires": ["MAPTILER_KEY"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 512,
      "attribution": "MapTiler · OpenStreetMap contributors",
      "status": "experimental"
    }
  ],
  "layers": [
    { "id": "google-satellite", "name": "Google 卫星影像", "kind": "imagery", "role": "base", "sourceId": "google-satellite", "visible": true, "exclusiveGroup": "basemap" },
    { "id": "google-roadmap", "name": "Google 道路地图", "kind": "imagery", "role": "base", "sourceId": "google-roadmap", "exclusiveGroup": "basemap" },
    { "id": "google-hybrid", "name": "Google 卫星混合图", "kind": "imagery", "role": "base", "sourceId": "google-hybrid", "exclusiveGroup": "basemap" },
    { "id": "google-terrain-map", "name": "Google 地形地图", "kind": "imagery", "role": "base", "sourceId": "google-terrain-map", "exclusiveGroup": "basemap" },
    { "id": "osm-standard", "name": "OpenStreetMap 标准地图", "kind": "imagery", "role": "base", "sourceId": "osm-standard", "exclusiveGroup": "basemap" },
    { "id": "osm-humanitarian", "name": "HOT 人道主义地图", "kind": "imagery", "role": "base", "sourceId": "osm-humanitarian", "exclusiveGroup": "basemap" },
    { "id": "osm-vector", "name": "OpenStreetMap 官方矢量瓦片（待原生渲染）", "kind": "vector", "role": "base", "sourceId": "osm-vector", "exclusiveGroup": "basemap" },
    { "id": "tianditu-imagery", "name": "天地图影像", "kind": "imagery", "role": "base", "sourceId": "tianditu-imagery", "exclusiveGroup": "basemap", "annotationLayerIds": ["tianditu-imagery-labels"] },
    { "id": "tianditu-imagery-labels", "name": "天地图影像中文注记", "kind": "annotation", "role": "annotation", "sourceId": "tianditu-imagery-labels", "parentLayerId": "tianditu-imagery" },
    { "id": "tianditu-vector", "name": "天地图矢量底图（栅格）", "kind": "imagery", "role": "base", "sourceId": "tianditu-vector", "exclusiveGroup": "basemap", "annotationLayerIds": ["tianditu-vector-labels"] },
    { "id": "tianditu-vector-labels", "name": "天地图矢量中文注记", "kind": "annotation", "role": "annotation", "sourceId": "tianditu-vector-labels", "parentLayerId": "tianditu-vector" },
    { "id": "tianditu-terrain", "name": "天地图地形晕渲", "kind": "imagery", "role": "base", "sourceId": "tianditu-terrain", "exclusiveGroup": "basemap", "annotationLayerIds": ["tianditu-terrain-labels"] },
    { "id": "tianditu-terrain-labels", "name": "天地图地形中文注记", "kind": "annotation", "role": "annotation", "sourceId": "tianditu-terrain-labels", "parentLayerId": "tianditu-terrain" },
    { "id": "esri-vector-basemap", "name": "Esri 矢量底图（兼容渲染）", "kind": "rasterized-vector", "role": "base", "sourceId": "esri-vector-basemap", "exclusiveGroup": "basemap" },
    { "id": "maptiler-streets", "name": "MapTiler Streets（兼容渲染）", "kind": "rasterized-vector", "role": "base", "sourceId": "maptiler-streets", "exclusiveGroup": "basemap" }
  ]
}
