{
  "$schema": "./public/layer-catalog.schema.json",
  "version": 1,
  "defaultBaseLayerId": "google-satellite",
  "defaults": {
    "levelOffset": -1.7
  },
  "sources": [
    {
      "id": "google-satellite",
      "name": "Google 卫星影像",
      "kind": "xyz-raster",
      "urlTemplate": "https://mt{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
      "subdomains": ["0", "1", "2", "3"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "Google Maps",
      "termsUrl": "https://developers.google.com/maps/documentation/tile/policies",
      "status": "experimental",
      "note": "兼容旧版 XYZ 端点；生产环境应迁移到需要 API Key 与会话令牌的 Google Map Tiles API。"
    },
    {
      "id": "google-roadmap",
      "name": "Google 道路地图",
      "kind": "xyz-raster",
      "urlTemplate": "https://mt{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}",
      "subdomains": ["0", "1", "2", "3"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "Google Maps",
      "termsUrl": "https://developers.google.com/maps/documentation/tile/policies",
      "status": "experimental",
      "coordinateReference": "gcj02-webmercator-in-china",
      "note": "兼容旧版 XYZ 端点；中国区道路数据使用 GCJ-02，与 WGS84 地表存在位置偏移。"
    },
    {
      "id": "google-hybrid",
      "name": "Google 卫星混合图",
      "kind": "xyz-raster",
      "urlTemplate": "https://mt{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}",
      "subdomains": ["0", "1", "2", "3"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "Google Maps",
      "termsUrl": "https://developers.google.com/maps/documentation/tile/policies",
      "status": "experimental",
      "coordinateReference": "gcj02-webmercator-in-china",
      "note": "兼容旧版 XYZ 端点；中国区注记使用 GCJ-02，当前尚未执行 WGS84 反纠偏。"
    },
    {
      "id": "google-terrain-map",
      "name": "Google 地形地图",
      "kind": "xyz-raster",
      "urlTemplate": "https://mt{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}",
      "subdomains": ["0", "1", "2", "3"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "Google Maps",
      "termsUrl": "https://developers.google.com/maps/documentation/tile/policies",
      "status": "experimental",
      "coordinateReference": "gcj02-webmercator-in-china",
      "note": "这是地形制图底图，不是 Terrain-RGB 高程；中国区道路与注记使用 GCJ-02。"
    },
    {
      "id": "osm-standard",
      "name": "OpenStreetMap 标准地图",
      "kind": "xyz-raster",
      "urlTemplate": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "minLevel": 0,
      "maxLevel": 19,
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors",
      "termsUrl": "https://operations.osmfoundation.org/policies/tiles/",
      "status": "stable",
      "note": "只用于正常交互浏览；必须显示署名并遵守缓存、Referer 与禁止批量下载要求。"
    },
    {
      "id": "osm-humanitarian",
      "name": "HOT 人道主义地图（OSM 数据）",
      "kind": "xyz-raster",
      "urlTemplate": "https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png",
      "subdomains": ["a", "b", "c"],
      "minLevel": 0,
      "maxLevel": 19,
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors · Tiles style by HOT",
      "termsUrl": "https://www.hotosm.org/",
      "status": "experimental",
      "note": "第三方 OSM 栅格样式，不属于 OSMF 标准瓦片服务。"
    },
    {
      "id": "osm-vector",
      "name": "OpenStreetMap 官方矢量瓦片",
      "kind": "mvt",
      "urlTemplate": "https://vector.openstreetmap.org/${OSM_VECTOR_VERSION}/{z}/{x}/{y}.mvt",
      "requires": ["OSM_VECTOR_VERSION"],
      "minLevel": 0,
      "maxLevel": 14,
      "attribution": "© OpenStreetMap contributors",
      "termsUrl": "https://operations.osmfoundation.org/policies/vector/",
      "status": "planned",
      "note": "已进入图层目录，但要等原生 GPU MVT 样式渲染器接入后启用。"
    },
    {
      "id": "tianditu-imagery",
      "name": "天地图影像底图",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/img_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=img&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable"
    },
    {
      "id": "tianditu-imagery-labels",
      "name": "天地图影像中文注记",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/cia_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=cia&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable"
    },
    {
      "id": "tianditu-vector",
      "name": "天地图矢量底图（栅格服务）",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/vec_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=vec&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable",
      "note": "名称中的“矢量”是天地图产品类型，当前接口返回已绘制栅格瓦片；不是客户端 MVT。"
    },
    {
      "id": "tianditu-vector-labels",
      "name": "天地图矢量中文注记",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/cva_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=cva&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable"
    },
    {
      "id": "tianditu-terrain",
      "name": "天地图地形晕渲",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/ter_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=ter&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 14,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable",
      "note": "这是地形晕渲底图，不是 Terrain-RGB 高程。"
    },
    {
      "id": "tianditu-terrain-labels",
      "name": "天地图地形中文注记",
      "kind": "wmts-raster",
      "urlTemplate": "https://t{s}.tianditu.gov.cn/cta_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=cta&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=${TIANDITU_TOKEN}",
      "subdomains": ["0", "1", "2", "3", "4", "5", "6", "7"],
      "requires": ["TIANDITU_TOKEN"],
      "minLevel": 1,
      "maxLevel": 14,
      "tileSize": 256,
      "attribution": "天地图",
      "status": "stable"
    },
    {
      "id": "geojson-china-provinces",
      "name": "中国省级边界 GeoJSON",
      "kind": "geojson",
      "url": "/中国_省.geojson",
      "crs": "EPSG:4490",
      "maxFeatures": 100,
      "attribution": "本地测试数据",
      "status": "experimental"
    },
    {
      "id": "geojson-china-cities",
      "name": "中国市级边界 GeoJSON",
      "kind": "geojson",
      "url": "/中国_市.geojson",
      "crs": "EPSG:4490",
      "maxFeatures": 500,
      "attribution": "本地测试数据",
      "status": "experimental"
    },
    {
      "id": "geojson-china-counties",
      "name": "中国县级边界 GeoJSON",
      "kind": "geojson",
      "url": "/中国_县.geojson",
      "crs": "EPSG:4490",
      "maxFeatures": 3500,
      "attribution": "本地测试数据",
      "status": "experimental"
    },
    {
      "id": "business-yongyuan-static",
      "name": "永远村正射影像",
      "kind": "xyz-raster",
      "urlTemplate": "/test/business-map/static/重庆市/垫江县/太平镇/永远村/{z}/{x}/{-y}.png",
      "minLevel": 1,
      "maxLevel": 18,
      "tileSize": 256,
      "levelOffset": 0,
      "bounds": [107.28022601157667, 30.22590963073708, 107.31053606757814, 30.25515782092512],
      "attribution": "码上种田 · 永远村正射影像 · 2026-07-30",
      "status": "experimental",
      "note": "TMS 静态瓦片，{-y} 为反转行号；范围和 1-18 级来自 tilemapresource.xml。"
    },
    {
      "id": "local-geoserver-usa-wmts",
      "name": "本机 GeoServer USA（WMTS）",
      "kind": "wmts-raster",
      "capabilitiesUrl": "/test/geoserver/geoserver/gwc/service/wmts?SERVICE=WMTS&REQUEST=GetCapabilities&VERSION=1.0.0",
      "endpointBaseUrl": "/test/geoserver",
      "layer": "nurc:usa",
      "style": "raster",
      "format": "image/png",
      "tileMatrixSet": "EPSG:900913",
      "requestEncoding": "auto",
      "minLevel": 0,
      "maxLevel": 30,
      "tileSize": 256,
      "attribution": "Local GeoServer · nurc:usa",
      "status": "experimental",
      "note": "测试数据.md 提供的本机服务；运行时解析 GetCapabilities，服务未启动时切换会显示独立错误状态。"
    },
    {
      "id": "local-geoserver-adminxian-wmts",
      "name": "本机 GeoServer 行政县（WMTS）",
      "kind": "wmts-raster",
      "capabilitiesUrl": "/test/geoserver/geoserver/gwc/service/wmts?SERVICE=WMTS&REQUEST=GetCapabilities&VERSION=1.0.0",
      "endpointBaseUrl": "/test/geoserver",
      "layer": "ne:adminxian",
      "style": "polygon",
      "format": "image/png",
      "tileMatrixSet": "EPSG:900913",
      "requestEncoding": "auto",
      "minLevel": 0,
      "maxLevel": 30,
      "tileSize": 256,
      "attribution": "Local GeoServer · ne:adminxian",
      "status": "experimental",
      "note": "服务端矢量样式绘制为 WMTS PNG；不是客户端原生矢量图层。"
    },
    {
      "id": "local-china-admin-mvt",
      "name": "本机 China Admin MVT",
      "kind": "mvt",
      "urlTemplate": "/test/mapservice/mapservice/vector/china_admin/tile/{z}/{x}/{y}",
      "styleUrl": "/styles/china-admin-overlay.json",
      "sourceId": "china_admin",
      "scheme": "xyz",
      "minLevel": 0,
      "maxLevel": 18,
      "tileSize": 512,
      "bounds": [73.0, 18.0, 135.1, 53.7],
      "attribution": "Local china_admin service",
      "status": "experimental",
      "note": "测试数据.md 提供的 typed MVT；使用自定义透明 Style v8，通过原生 GPU 点线面与独立注记通道作为业务图层贴地叠加。"
    },
    {
      "id": "esri-vector-basemap",
      "name": "Esri 矢量底图（兼容栅格化）",
      "kind": "rasterized-vector-style",
      "styleUrl": "/En.json",
      "sourceId": "esri",
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 512,
      "minimumLodLevelOffset": -1,
      "showCountryLabels": true,
      "attribution": "Esri",
      "status": "stable",
      "note": "使用 public/En.json 标准 Style v8 输入；MVT 在 CPU/Canvas 按样式绘制为贴地纹理。"
    },
    {
      "id": "esri-native-vector",
      "name": "Esri 原生矢量底图（地表初版）",
      "kind": "mvt",
      "styleUrl": "/En.json",
      "sourceId": "esri",
      "scheme": "xyz",
      "urlTemplate": "https://basemaps.arcgis.com/arcgis/rest/services/World_Basemap_v2/VectorTileServer/tile/{z}/{y}/{x}.pbf",
      "minLevel": 0,
      "maxLevel": 16,
      "attribution": "Esri",
      "status": "experimental",
      "note": "PBF 到 z16；更高层级从矢量父数据重绘，不放大旧纹理；symbol、pattern、完整线连接待实现。"
    },
    {
      "id": "maptiler-streets",
      "name": "MapTiler Streets（兼容栅格化）",
      "kind": "rasterized-vector-style",
      "styleUrl": "https://api.maptiler.com/maps/streets-v4/style.json?key=${MAPTILER_KEY}",
      "sourceId": "maptiler_planet_v4",
      "requires": ["MAPTILER_KEY"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 512,
      "attribution": "MapTiler · OpenStreetMap contributors",
      "status": "experimental",
      "note": "通过 Mapbox Style v8 source.url 解析矢量 TileJSON，再由兼容 Canvas 路径栅格化。"
    },
    {
      "id": "maptiler-hybrid-raster",
      "name": "MapTiler Hybrid 卫星混合图",
      "kind": "xyz-raster",
      "urlTemplate": "https://api.maptiler.com/maps/hybrid-v4/256/{z}/{x}/{y}.jpg?key=${MAPTILER_KEY}",
      "requires": ["MAPTILER_KEY"],
      "minLevel": 0,
      "maxLevel": 20,
      "tileSize": 256,
      "attribution": "MapTiler · OpenStreetMap contributors",
      "termsUrl": "https://www.maptiler.com/cloud/",
      "status": "stable",
      "note": "直接使用 MapTiler TileJSON 返回的 256px XYZ 栅格模板。"
    }
  ],
  "layers": [
    { "id": "google-satellite", "name": "Google 卫星影像", "kind": "imagery", "role": "base", "sourceId": "google-satellite", "visible": true, "exclusiveGroup": "basemap" },
    { "id": "google-roadmap", "name": "Google 道路地图", "kind": "imagery", "role": "base", "sourceId": "google-roadmap", "exclusiveGroup": "basemap" },
    { "id": "google-hybrid", "name": "Google 卫星混合图", "kind": "imagery", "role": "base", "sourceId": "google-hybrid", "exclusiveGroup": "basemap" },
    { "id": "google-terrain-map", "name": "Google 地形地图", "kind": "imagery", "role": "base", "sourceId": "google-terrain-map", "exclusiveGroup": "basemap" },
    { "id": "osm-standard", "name": "OpenStreetMap 标准地图", "kind": "imagery", "role": "base", "sourceId": "osm-standard", "exclusiveGroup": "basemap" },
