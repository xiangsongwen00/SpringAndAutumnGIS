# 地形默认关闭，普通影像浏览不会承担 DEM 解码和高密度网格开销。
VITE_ENABLE_TERRAIN=false

# 浏览器端只能使用公开或受域名限制的客户端凭据，禁止填写 Mapbox sk.* 私密令牌。
VITE_GEOVIS_TERRAIN_URL=https://tiles.example.com/terrain-rgb/{z}/{x}/{y}?token=YOUR_PUBLIC_TOKEN
VITE_GEOVIS_TERRAIN_SCHEME=xyz
VITE_MAPTILER_KEY=YOUR_PUBLIC_KEY
VITE_TIANDITU_TOKEN=YOUR_PUBLIC_TOKEN
VITE_OSM_VECTOR_VERSION=YOUR_SERVICE_VERSION
VITE_TERRAIN_EXAGGERATION=1
