{
  "name": "spring-and-autumn-gis",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Lightweight 3D GIS engine (library + demo).",
  "main": "./dist/spring-and-autumn-gis.umd.cjs",
  "module": "./dist/spring-and-autumn-gis.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/spring-and-autumn-gis.es.js",
      "require": "./dist/spring-and-autumn-gis.umd.cjs"
    }
  },
  "files": [
    "dist",
    "SDK使用说明.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepack": "npm run build",
    "test:sdk": "node scripts/test-sdk-package.mjs",
    "test:entities": "node scripts/test-entities.mjs",
    "test:picking": "node scripts/test-surface-picking.mjs",
    "test:entities:browser": "node scripts/test-entity-demo-browser.mjs",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test-layer-management.mjs && node scripts/test-tile-runtime.mjs && node scripts/test-raster-orientation.mjs && node scripts/test-raster-continuity.mjs && node scripts/test-terrain-stitch.mjs && node scripts/test-vector-pipeline.mjs && node scripts/test-lod-visibility.mjs && node scripts/test-lod-budget.mjs && node scripts/test-lod-mountain-detail.mjs && node scripts/test-vector-performance.mjs && node scripts/test-terrain-dynamic.mjs && node scripts/test-terrain-coverage.mjs && node scripts/test-entities.mjs",
    "test:vector": "npm run build && node scripts/test-vector-pipeline.mjs",
    "test:vector:browser": "node scripts/test-vector-browser.mjs",
    "test:terrain": "npm run build && node scripts/test-terrain-stitch.mjs",
    "test:layers": "npm run build && node scripts/test-layer-management.mjs",
    "test:runtime": "npm run build && node scripts/test-tile-runtime.mjs && node scripts/test-raster-orientation.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "three": "^0.182.0",
    "typescript": "^5.4.5",
    "vite": "^5.1.4"
  },
  "peerDependencies": {
    "three": "^0.182.0",
    "@types/three": "^0.182.0"
  },
  "peerDependenciesMeta": {
    "@types/three": { "optional": true }
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "pbf": "^5.1.2"
  }
}
