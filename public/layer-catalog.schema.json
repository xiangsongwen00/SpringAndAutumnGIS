{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spring-and-autumn-gis.local/schemas/layer-catalog.schema.json",
  "title": "SpringAndAutumnGIS Layer Catalog",
  "type": "object",
  "required": ["version", "defaultBaseLayerId", "defaults", "sources", "layers"],
  "properties": {
    "version": { "const": 1 },
    "defaultBaseLayerId": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object",
      "required": ["levelOffset"],
      "properties": {
        "levelOffset": { "type": "number", "minimum": -8, "maximum": 2 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["xyz-raster", "wmts-raster", "rasterized-vector-style", "mvt", "geojson"] },
          "urlTemplate": { "type": "string" },
          "capabilitiesUrl": { "type": "string" },
          "layer": { "type": "string" },
          "style": { "type": "string" },
          "format": { "type": "string" },
          "tileMatrixSet": { "type": "string" },
          "requestEncoding": { "enum": ["auto", "rest", "kvp"] },
          "endpointBaseUrl": { "type": "string" },
          "url": { "type": "string" },
          "crs": { "type": "string" },
          "maxFeatures": { "type": "integer", "minimum": 1 },
          "styleUrl": { "type": "string" },
          "sourceId": { "type": "string" },
          "scheme": { "enum": ["xyz", "tms"] },
          "subdomains": { "type": "array", "items": { "type": "string" } },
          "requires": { "type": "array", "items": { "type": "string" } },
          "minLevel": { "type": "integer", "minimum": 0 },
          "maxLevel": { "type": "integer", "minimum": 0 },
          "tileSize": { "type": "integer", "minimum": 1 },
          "bounds": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -85.05112878, "maximum": 85.05112878 },
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -85.05112878, "maximum": 85.05112878 }
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "levelOffset": { "type": "number", "minimum": -8, "maximum": 2 },
          "minimumLodLevelOffset": { "type": "number" },
          "showCountryLabels": { "type": "boolean" },
          "attribution": { "type": "string" },
          "termsUrl": { "type": "string" },
          "status": { "enum": ["stable", "experimental", "planned"] },
          "note": { "type": "string" },
          "coordinateReference": { "enum": ["wgs84-webmercator", "gcj02-webmercator-in-china"] }
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "role", "sourceId"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["imagery", "rasterized-vector", "terrain", "vector", "feature", "annotation"] },
          "role": { "enum": ["base", "overlay", "annotation", "terrain"] },
          "sourceId": { "type": "string", "minLength": 1 },
          "visible": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "levelOffset": { "type": "number", "minimum": -8, "maximum": 2 },
          "exclusiveGroup": { "type": "string" },
          "parentLayerId": { "type": "string" },
          "annotationLayerIds": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
